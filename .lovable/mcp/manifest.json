                "criacao",
                "reuniao"
              ]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "search_lead",
        "title": "Buscar lead",
        "description": "Busca um lead por nome ou telefone e devolve o histórico dele no painel: todas as reuniões (com closer, status e motivo) e o resultado de venda de cada uma.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
