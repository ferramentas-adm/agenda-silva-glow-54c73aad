  "mcp": {
    "server": {
      "name": "grupo-silva-agenda-mcp",
      "version": "0.2.0",
      "title": "Painel de Agendamentos — Grupo Silva"
    },
    "tools": [
      {
        "name": "list_appointments",
        "title": "Listar reuniões agendadas",
        "description": "Lista reuniões do painel (agendamentos) por período e/ou status, já com nome do closer e do SDR responsável. Respeita a permissão do usuário autenticado (RLS).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "from_date": {
              "description": "Data inicial (YYYY-MM-DD). Padrão: hoje.",
              "type": "string"
            },
            "to_date": {
              "description": "Data final (YYYY-MM-DD, inclusiva). Padrão: 30 dias após from_date.",
              "type": "string"
            },
            "status": {
              "description": "Filtrar por status.",
              "type": "string",
              "enum": [
                "pendente",
                "confirmada",
                "agendada",
                "nao_confirmada",
                "em_call",
                "realizada",
                "cancelada",
                "no_show"
              ]
            },
            "closer_name": {
              "description": "Filtrar por nome do closer (match parcial).",
              "type": "string"
            },
            "sdr_name": {
              "description": "Filtrar por nome do SDR responsável (match parcial).",
              "type": "string"
            },
            "limit": {
              "description": "Máximo de resultados (padrão 100, teto 500).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_appointment",
        "title": "Detalhes da reunião",
        "description": "Retorna os detalhes completos de uma reunião pelo id, incluindo closer, SDR e resultado da venda.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "ID (uuid) da reunião."
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "agenda_availability",
        "title": "Ocupação e horários livres da agenda",
        "description": "Mostra a ocupação da agenda por dia e horário no período: quantas reuniões por horário, quantos closers ativos, horários lotados (não oferecer ao lead) e os horários mais vazios. Respeita os horários comerciais configurados no painel.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "from_date": {
              "description": "Data inicial (YYYY-MM-DD). Padrão: hoje.",
              "type": "string"
            },
            "to_date": {
              "description": "Data final (YYYY-MM-DD, inclusiva). Padrão: from_date + 6 dias.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_sales",
        "title": "Listar vendas",
        "description": "Lista as vendas (e opcionalmente as não fechadas) do período, com closer, lead, valor, order bumps e origem (1ª call ou follow-up). A venda é atribuída à data de fechamento quando informada, senão à data de registro.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "from": {
              "description": "Data inicial (YYYY-MM-DD). Padrão: início do mês corrente.",
              "type": "string"
            },
            "to": {
              "description": "Data final (YYYY-MM-DD, inclusiva). Padrão: hoje.",
              "type": "string"
            },
            "closer_name": {
              "description": "Filtrar por nome do closer (match parcial).",
              "type": "string"
            },
            "incluir_nao_fechadas": {
              "description": "Se true, inclui também as reuniões que não fecharam venda. Padrão: só vendas fechadas.",
              "type": "boolean"
            },
            "limit": {
              "description": "Máximo de itens (padrão 200, teto 500).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "sales_kpis",
        "title": "KPIs de vendas do período",
        "description": "Números consolidados do período (mesma fonte da página Vendas): vendas de 1ª call e de follow-up, vendas avulsas, valor coletado e faturado, não fechou, reuniões realizadas e taxa de conversão.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "from": {
              "description": "Data inicial (YYYY-MM-DD). Padrão: início do mês corrente.",
