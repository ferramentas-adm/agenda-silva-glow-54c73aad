      {
        "name": "sdr_productivity",
        "title": "Produtividade dos SDRs",
        "description": "Agendamentos criados por SDR no período (pela data de criação), com quantas foram realizadas, quantas não compareceram, taxa de comparecimento e vendas geradas.",
        "annotations": {
          "readOnlyHint": true,
