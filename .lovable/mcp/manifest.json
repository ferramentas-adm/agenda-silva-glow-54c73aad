            },
            "to": {
              "description": "Data final (YYYY-MM-DD, inclusiva). Padrão: hoje.",
              "type": "string"
            },
            "closer_id": {
              "description": "Restringir a um closer (uuid).",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "closer_performance",
        "title": "Performance por closer",
        "description": "Ranking por closer no período: reuniões realizadas, vendas, receita e taxa de conversão (inclui closers com zero venda). Mesma fonte da página Vendas.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "from": {
              "description": "Data inicial (YYYY-MM-DD). Padrão: início do mês corrente.",
              "type": "string"
            },
            "to": {
              "description": "Data final (YYYY-MM-DD, inclusiva). Padrão: hoje.",
              "type": "string"
            },
            "canal": {
              "description": "Filtrar por canal (channel_type), ex.: inbound.",
              "type": "string"
            },
            "ordenar_por": {
              "description": "Padrão: conversao.",
              "type": "string",
              "enum": [
                "conversao",
                "vendas",
                "receita",
                "realizadas"
              ]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_followups",
