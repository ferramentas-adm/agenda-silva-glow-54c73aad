            "limit": {
              "description": "Máximo de itens por bloco (padrão 200, teto 500).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
